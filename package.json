{
    "name": "bongobot",
    "version": "0.0.1",
    "description": "",
    "main": "app.js",
    "type": "module",
    "engines": {
        "node": "16.x"
    },
    "scripts": {
        "start": "node app.js",
        "register-guild-commands": "node ./commands/installguild.js",
        "register-global-commands": "node ./commands/installglobal.js",
        "remove-guild-commands": "node ./commands/removeguild.js",
        "register-roles": "node ./roles/installroles.js",
        "remove-achievement": "node ./roles/deleteUserAchievement.js",
        "mongo": "node mongo.js",
        "dev": "nodemon app.js",
        "test": "jasmine",
        "build:css": "postcss ./public/src/input.css -o ./public/dist/output.css",
        "watch:css": "postcss ./public/src/input.css -o ./public/dist/output.css --watch",
        "migrate:roles:up": "node ./migrations/001-seed-roles.up.js",
        "migrate:roles:down": "node ./migrations/001-seed-roles.down.js",
        "migrate:games:up": "node ./migrations/002-seed-games.up.js",
        "migrate:games:down": "node ./migrations/002-seed-games.down.js",
        "migrate:anchors:up": "node ./migrations/003-seed-role-position-anchors.up.js",
        "migrate:anchors:down": "node ./migrations/003-seed-role-position-anchors.down.js"
    },
    "author": "Casey Crocamo",
    "license": "MIT",
    "dependencies": {
        "date-format-parse": "^0.2.7",
        "discord-interactions": "^3.2.0",
        "dotenv": "^16.0.3",
        "express": "^4.18.2",
        "mongodb": "^6.6.2",
        "node-fetch": "^3.3.0"
    },
    "devDependencies": {
        "@flydotio/dockerfile": "^0.5.7",
        "@tailwindcss/postcss": "^4.3.3",
        "jasmine": "^5.1.0",
        "nodemon": "^2.0.15",
        "postcss": "^8.5.25",
        "postcss-cli": "^11.0.1",
        "tailwindcss": "^4.3.3"
    }
}
